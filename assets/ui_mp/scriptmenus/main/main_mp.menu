#include "ui/components/base.inc"

#define MAIN_PLAY				scriptMenuResponse "autoassign"; close main_mp;
#define MAIN_SPECTATOR			scriptMenuResponse "spectator"; close main_mp;
#define MAIN_CUSTOMIZE			open sr_customize; close main_mp;
#define MAIN_LEADERBOARDS		open sr_leaderboard; close main_mp;
#define MAIN_CONTROLS			open main_controls; close main_mp;
#define MAIN_SETTINGS			open main_options; open sr_settings; close main_mp;
#define MAIN_VOTE				open sr_votemap; close main_mp;
#define MAIN_QUIT				open exit_popmenu;
#define MAIN_ABOUT				open about_page_1; close main_mp;

// One stat on a row: label on the left in the muted white, value on the right.
#define MAIN_STAT(y, label, value) \
	RAIL_TEXT(439, y, 190, 30, label, 0.28, ITEM_ALIGN_MIDDLE_LEFT, 8, RAIL_MUTED) \
	RAIL_TEXT(439, y, 190, 30, value, 0.3, ITEM_ALIGN_MIDDLE_RIGHT, -8, RAIL_WHITE)

#define MAIN_SHADER(x, y, w, h, materialArg, vis) \
	itemDef \
	{ \
		rect			x y w h SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_SHADER \
		background		materialArg \
		visible			vis \
		decoration \
	}

{
	menuDef
	{
		name			"main_mp"
		rect			SR_WINDOW_RECT
		focusColor		1 1 1 1

		onOpen
		{
			setLocalVarInt ui_rail_hover 0;
		}

		onESC
		{
			close self;
		}

		RAIL_FILL(0, 0, SR_WINDOW_W, SR_WINDOW_H, SR_WINDOW_BACKCOLOR)

		RAIL_PANEL(178, 410, "SR ^5SPEEDRUN")
		RAIL_ENTRY_PRIMARY(1, 10, 58, 158, 28, "Play", MAIN_PLAY)
		RAIL_ENTRY(2, 10, 90, 158, 28, "Spectator", MAIN_SPECTATOR)
		RAIL_ENTRY(3, 10, 122, 158, 28, "Customize", MAIN_CUSTOMIZE)
		RAIL_ENTRY(4, 10, 154, 158, 28, "Leaderboards", MAIN_LEADERBOARDS)
		RAIL_ENTRY(5, 10, 186, 158, 28, "Controls", MAIN_CONTROLS)
		RAIL_ENTRY(6, 10, 218, 158, 28, "Settings", MAIN_SETTINGS)
		RAIL_ENTRY(7, 10, 250, 158, 28, "Vote", MAIN_VOTE)
		RAIL_RULE(10, 362, 158)
		RAIL_ENTRY(8, 10, 372, 158, 28, "Quit", MAIN_QUIT)

		// Player
		SR_FRAME(192, 10, 438, 62)
		RAIL_FILL(192, 10, 2, 62, RAIL_PURPLE)
		itemDef
		{
			name			"rankIcon"
			rect			204 21 40 40 SR_ALIGN_TOP_SUBLEFT
			style			WINDOW_STYLE_SHADER
			exp				material(tablelookup("mp/rankIconTable.csv", 0, stat(2350), stat(2326) + 1))
			visible			1
			decoration
		}
		RAIL_TEXT(254, 16, 300, 26, dvarString("name"), 0.4, ITEM_ALIGN_MIDDLE_LEFT, 0, RAIL_WHITE)
		RAIL_TEXT(254, 42, 300, 20, dvarString("sr_admin_role"), 0.26, ITEM_ALIGN_MIDDLE_LEFT, 0, RAIL_MUTED)
		MAIN_SHADER(576, 31, 20, 20, "speedrunner_logo", when(stat(2001)))
		MAIN_SHADER(602, 31, 20, 20, "vip_status", when(stat(2000)))

		// Map
		SR_FRAME(192, 82, 238, 190)
		SR_FRAME_HEADER(dvarString("mapname"), 195, 84, 234, 25, 6)
		MAIN_SHADER(195, 109, 234, 161, "$levelBriefing", 1)

		// Stats
		SR_FRAME_SECONDARY(438, 82, 192, 190)
		SR_FRAME_HEADER("Stats", 441, 84, 188, 25, 6)
		MAIN_STAT(111, "Personal Best", dvarString("sr_leaderboard_pb"))
		MAIN_STAT(143, "World Record", dvarString("sr_leaderboard_wr"))
		MAIN_STAT(175, "WR Count", dvarString("sr_leaderboard_wr_count"))
		MAIN_STAT(207, "Leaderboard Entries", ("" + stat(2002)))
		MAIN_STAT(239, "Time Played", dvarString("sr_info_timePlayed"))
		RAIL_FILL(447, 142, 174, 1, RAIL_LINE)
		RAIL_FILL(447, 174, 174, 1, RAIL_LINE)
		RAIL_FILL(447, 206, 174, 1, RAIL_LINE)
		RAIL_FILL(447, 238, 174, 1, RAIL_LINE)

		// About
		SR_FRAME(192, 282, 438, 120)
		SR_FRAME_HEADER("About", 195, 284, 434, 25, 6)
		itemDef
		{
			name			"aboutText"
			rect			202 312 418 60 SR_ALIGN_TOP_SUBLEFT
			type			ITEM_TYPE_TEXT
			text			"Welcome to ^5SR Speedrun^7, a competitive ^5speedrunning server^7 featuring ^57 unique movement modes^7, over ^512,000 ^7unique players, and ^5150,000+^7 records on the leaderboards.\n\nFor more info, ^2click Read More^7."
			textfont		UI_FONT_NORMAL
			textscale		0.26
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			textalign		ITEM_ALIGN_TOP_LEFT
			forecolor		RAIL_WHITE
			autowrapped
			visible			1
			decoration
		}
		RAIL_BUTTON(9, 530, 374, 92, 22, "Read more", 0.26, MAIN_ABOUT)
	}
}
