#define SR_WINDOW_HEADER_H		40

#include "ui/components/base.inc"
#include "ui/components/leaderboard.inc"

// A way is on screen when it is shown under any of the seven modes.
#define SR_LB_SHOWN(wayDvar) \
	(LB_IS("190 ^7", wayDvar) || LB_IS("210 ^7", wayDvar) || LB_IS("Q3 ^7", wayDvar) || \
	LB_IS("Q3CPM ^7", wayDvar) || LB_IS("Q3CPMW ^7", wayDvar) || LB_IS("CS ^7", wayDvar) || \
	LB_IS("Portal ^7", wayDvar))

#define SR_LB_MODE(id, y, label, response, modePrefix) \
	LB_MODE(id, 14, y, 105, 24, label, response, modePrefix)

#define SR_LB_NORMAL(id, y, wayDvar, response) \
	LB_WAY(id, 131, y, 105, 24, wayDvar, response, LB_NORMAL_RGB, SR_LB_SHOWN(wayDvar))

// Secret ways carry on right after however many normal ways the map has.
#define SR_LB_SECRET(id, i, wayDvar, response) \
	LB_WAY_AT(id, 131, (72 + (26 * (LB_NORMAL_COUNT + i))), 105, 24, wayDvar, response, LB_SECRET_RGB, \
		SR_LB_SHOWN(wayDvar))

#define SR_LB_STRIPE(y) \
	LB_FILL(250, y, 380, 14.4, 1 1 1 0.04)

{
	menuDef
	{
		SR_WINDOW("sr_leaderboard")

		focusColor		COLOR_FOCUSED

		onOpen
		{
			setLocalVarInt ui_lb_hover 0;
			scriptMenuResponse "open";
		}

		onEsc
		{
			close self;
		}

		LB_TEXT(14, 0, 120, 40, "Leaderboards", 0.38, ITEM_ALIGN_MIDDLE_LEFT, 1 1 1 1)
		LB_TEXT(140, 0, 330, 40, dvarString("leaderboard_name"), 0.32, ITEM_ALIGN_MIDDLE_LEFT, 0 1 1 1)

		LB_COLUMN(10, 48, 113, 356, "Modes")
		SR_LB_MODE(1, 72, "190", "mode:190", "190 ^7")
		SR_LB_MODE(2, 98, "210", "mode:210", "210 ^7")
		SR_LB_MODE(3, 124, "Q3", "mode:Q3", "Q3 ^7")
		SR_LB_MODE(4, 150, "Q3CPM", "mode:Q3CPM", "Q3CPM ^7")
		SR_LB_MODE(5, 176, "Q3CPMW", "mode:Q3CPMW", "Q3CPMW ^7")
		SR_LB_MODE(6, 202, "CS", "mode:CS", "CS ^7")
		SR_LB_MODE(7, 228, "Portal", "mode:Portal", "Portal ^7")

		LB_COLUMN(127, 48, 113, 356, "Ways")
		SR_LB_NORMAL(11, 72, "normal_0", "way:normal_0")
		SR_LB_NORMAL(12, 98, "normal_1", "way:normal_1")
		SR_LB_NORMAL(13, 124, "normal_2", "way:normal_2")
		SR_LB_NORMAL(14, 150, "normal_3", "way:normal_3")
		SR_LB_NORMAL(15, 176, "normal_4", "way:normal_4")
		SR_LB_NORMAL(16, 202, "normal_5", "way:normal_5")
		SR_LB_SECRET(21, 0, "secret_0", "way:secret_0")
		SR_LB_SECRET(22, 1, "secret_1", "way:secret_1")
		SR_LB_SECRET(23, 2, "secret_2", "way:secret_2")
		SR_LB_SECRET(24, 3, "secret_3", "way:secret_3")
		SR_LB_SECRET(25, 4, "secret_4", "way:secret_4")
		SR_LB_SECRET(26, 5, "secret_5", "way:secret_5")

		// The forty times in one panel, a stripe on every other row.
		LB_FILL(250, 48, 380, 312, 0 0 0 0.3)
		SR_LB_STRIPE(74.4)
		SR_LB_STRIPE(103.2)
		SR_LB_STRIPE(132)
		SR_LB_STRIPE(160.8)
		SR_LB_STRIPE(189.6)
		SR_LB_STRIPE(218.4)
		SR_LB_STRIPE(247.2)
		SR_LB_STRIPE(276)
		SR_LB_STRIPE(304.8)
		SR_LB_STRIPE(333.6)
		LB_TIMES(250, 440, 8, 34, 132, 71.52, 0.3)

		LB_DEMO(8, 250, 368, 380, 32, "Watch World Record")
	}
}
