// About pages: a striped contents list down the left with every chapter one click away, the page beside it.
#include "ui/components/base.inc"

#define ABOUT_TEXT_COLOR	0.85 0.85 0.85 1
#define ABOUT_HOVER(pid)	(localVarInt(ui_about_hover) == pid)
#define ABOUT_ROW_Y(pk)		(84 + ((pk) - 1) * 34)

#define ABOUT_TITLE_1		"Welcome"
#define ABOUT_TITLE_2		"Commands"
#define ABOUT_TITLE_3		"Game Modes"
#define ABOUT_TITLE_4		"Leaderboard"
#define ABOUT_TITLE_5		"XP"
#define ABOUT_TITLE_6		"How to play"
#define ABOUT_TITLE_7		"IW3SR"
#define ABOUT_TITLE_8		"Open Source"
#define ABOUT_TITLE_9		"Community"

#define ABOUT_FILL(px, py, pw, ph, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			1 \
		decoration \
	}

#define ABOUT_FILL_IF(px, py, pw, ph, pcolor, pcond) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			when(pcond) \
		decoration \
	}

#define ABOUT_LABEL(px, py, pw, ph, ptext, pscale, palign, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			ptext \
		textfont		UI_FONT_NORMAL \
		textscale		pscale \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		forecolor		pcolor \
		visible			1 \
		decoration \
	}

// The page text keeps its own line breaks, so it is not wrapped: py is the first line's baseline and
// lines are 14.4 apart. The longest lines need about 380 of width at this scale.
#define ABOUT_BODY(px, py, pbody) \
	itemDef \
	{ \
		rect			px py 384 230 SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			pbody \
		textfont		UI_FONT_NORMAL \
		textscale		0.3 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		ITEM_ALIGN_LEFT \
		forecolor		ABOUT_TEXT_COLOR \
		visible			1 \
		decoration \
	}

// Clickable part of a page link. pid lights the ABOUT_HOVER items drawn under it, unique in the page.
#define ABOUT_HIT(pid, px, py, pw, ph, plabel, palign, palignx, ptarget, pcond) \
	itemDef \
	{ \
		type			ITEM_TYPE_BUTTON \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		text			plabel \
		textfont		UI_FONT_NORMAL \
		textscale		0.26 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		textalignx		palignx \
		forecolor		1 1 1 1 \
		visible			when(pcond) \
		onFocus \
		{ \
			play "mouse_over"; \
			setLocalVarInt ui_about_hover pid; \
		} \
		leaveFocus \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		action \
		{ \
			play "mouse_click"; \
			close self; \
			open ptarget; \
		} \
	}

// pk is the chapter listed, ppage the page drawing the list; both are plain numbers.
#define ABOUT_CHAPTER(pk, ptitle, ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0.5 0.1 1 0.55, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 3, 34, 0 1 1 1, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0 1 1 0.14, ABOUT_HOVER(pk)) \
	ABOUT_LABEL(44, ABOUT_ROW_Y(pk), 20, 34, #pk, 0.26, ITEM_ALIGN_MIDDLE_RIGHT, ABOUT_TEXT_COLOR) \
	ABOUT_HIT(pk, 38, ABOUT_ROW_Y(pk), 154, 34, ptitle, ITEM_ALIGN_MIDDLE_LEFT, 34, about_page_##pk, 1)

// Previous or next. Like the original, the first page's previous and the last page's next reopen it.
#define ABOUT_STEP(pid, px, plabel, ptarget) \
	ABOUT_FILL(px, 364, 100, 26, 0.5 0.1 1 0.45) \
	ABOUT_FILL_IF(px, 364, 100, 26, 0 1 1 0.2, ABOUT_HOVER(pid)) \
	ABOUT_HIT(pid, px, 364, 100, 26, plabel, ITEM_ALIGN_MIDDLE_CENTER, 0, ptarget, 1)

#define ABOUT_PAGE(ppage, pprev, pnext, ptitle, pbody) \
	menuDef \
	{ \
		name			"about_page_" ## #ppage \
		rect			0 0 640 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
		focusColor		0 1 1 1 \
		onOpen \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		onEsc \
		{ \
			close self; \
		} \
		itemDef \
		{ \
			name			"window" \
			rect			30 50 580 350 SR_ALIGN_TOP_SUBLEFT \
			style			WINDOW_STYLE_FILLED \
			backcolor		0 0 0 0.6 \
			border			WINDOW_BORDER_FULL \
			bordersize		1 \
			bordercolor		0.5 0.1 1 0.6 \
			visible			1 \
			decoration \
		} \
		ABOUT_FILL(31, 51, 168, 348, 0 0 0 0.35) \
		ABOUT_FILL(199, 51, 2, 348, 0.5 0.1 1 0.8) \
		ABOUT_LABEL(44, 52, 140, 30, "Contents", 0.24, ITEM_ALIGN_MIDDLE_LEFT, ABOUT_TEXT_COLOR) \
		ABOUT_FILL(38, 84, 154, 306, 0 0 0 0.3) \
		ABOUT_FILL(38, ABOUT_ROW_Y(2), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(4), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(6), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(8), 154, 34, 1 1 1 0.04) \
		ABOUT_CHAPTER(1, ABOUT_TITLE_1, ppage) \
		ABOUT_CHAPTER(2, ABOUT_TITLE_2, ppage) \
		ABOUT_CHAPTER(3, ABOUT_TITLE_3, ppage) \
		ABOUT_CHAPTER(4, ABOUT_TITLE_4, ppage) \
		ABOUT_CHAPTER(5, ABOUT_TITLE_5, ppage) \
		ABOUT_CHAPTER(6, ABOUT_TITLE_6, ppage) \
		ABOUT_CHAPTER(7, ABOUT_TITLE_7, ppage) \
		ABOUT_CHAPTER(8, ABOUT_TITLE_8, ppage) \
		ABOUT_CHAPTER(9, ABOUT_TITLE_9, ppage) \
		ABOUT_LABEL(216, 52, 380, 36, ptitle, 0.42, ITEM_ALIGN_MIDDLE_LEFT, 1 1 1 1) \
		ABOUT_FILL(216, 90, 380, 2, 0.5 0.1 1 1) \
		ABOUT_BODY(216, 116, pbody) \
		ABOUT_STEP(11, 216, "< Previous", about_page_##pprev) \
		ABOUT_LABEL(316, 364, 180, 26, #ppage ## " / 9", 0.26, ITEM_ALIGN_MIDDLE_CENTER, ABOUT_TEXT_COLOR) \
		ABOUT_STEP(12, 496, "Next >", about_page_##pnext) \
		execKeyInt 13 \
		{ \
			scriptmenuresponse "enter"; \
		} \
		execKeyInt 32 \
		{ \
			scriptmenuresponse "space"; \
		} \
	}

{
	ABOUT_PAGE(1, 1, 2, ABOUT_TITLE_1, "^7Welcome to ^5SR Speedrun^7, a competitive ^5Call of Duty 4^7 speedrunning server\nbuilt from the ground up for the movement community.\n\n^7Over ^512,000 unique players^7 have passed through these servers, collectively\nsetting more than ^5150,000 records^7 across all maps and movement modes.\n\n^7Whether you are chasing world records, grinding for a top 10, or just\ndiscovering speedrunning for the first time, SR has everything you need\nto get started, improve, and compete at the highest level.\n\n^57 movement modes^7, global leaderboards with demo playback,\n^580 levels^7, ^520 prestiges^7, anti-cheat, and a custom client built\nspecifically for the best possible experience on every mode.")
	ABOUT_PAGE(2, 1, 3, ABOUT_TITLE_2, "^7A large set of commands is available to all players at any time.\nType ^2!help^7 in chat to browse the full list. Here are the most useful ones:\n\n^2!practise ^7Enter practise mode to create save states.\n^2!teleport ^7Teleport to another player while in practise mode.\n^2!pm ^7Send a private message directly to another player on the server.\n^2!graphics ^7Re-enable common graphics settings if they were disabled.\n^2!fps ^7Toggle fullbright mode for improved frame rate.\n^2!fov ^7Adjust your field of view to your preference.\n^2!video ^7Request a video to be played on the in-game screen.\n^2!tas ^7Register yourself as a Tool Assisted Speedrun user.")
	ABOUT_PAGE(3, 2, 4, ABOUT_TITLE_3, "^77 movement modes are available, each with completely different physics\nand its own leaderboard. Switch between them at any time using chat commands.\n\n^2!190 ^7Original CoD4 movements at 190 speed with 1.05 scale.\n^2!210 ^7Original CoD4 movements at 210 speed with 1.12 scale.\n^2!Q3 ^7Quake 3 Arena original movement physics.\n^2!Q3CPM ^7Quake 3 Challenge Pro Mode, faster and tighter.\n^2!Q3CPMW ^7Quake 3 CPM with rocket launcher and plasma gun.\n^2!CS ^7Counter-Strike bhop and surf physics.\n^2!Portal ^7Counter-Strike movements with a portal gun.")
	ABOUT_PAGE(4, 3, 5, ABOUT_TITLE_4, "^7Every completed run is tracked across all maps and movement modes,\nbrowsable directly from the main menu at any time.\n\n^7Each map supports ^5multiple routes^7, each with its own independent\nleaderboard so that times are always compared fairly within the same path.\n\n^7Use the filters to sort by movement mode, map, or route to find exactly\nthe records you are looking for, whether checking your own rank or scouting\nthe competition.\n\n^7Hit the ^5demo^7 button on any leaderboard to watch a full in-game\nplayback of the WR. This is the best way to study exactly how a record\nwas achieved, what routes were taken, and what techniques were used.")
	ABOUT_PAGE(5, 4, 6, ABOUT_TITLE_5, "^7Every completed run on the leaderboard earns ^5XP^7 based on two factors:\nyour placement rank and how many total records exist on that route.\n\n^5Placement: ^7The higher your rank, the more XP you receive. First place\n^7always earns the most, but every position on the board rewards.\n^5Competition: ^7The more records that exist on a route, the more valuable\n^7the top spots become. Competitive maps reward more heavily.\n^5Early runs: ^7Being among the first to set a time on a new map or route\n^7always pays off as the pool grows around your record.\n\n^7There are ^580 levels^7 and ^520 prestiges^7 to progress through,\ntracked globally across every movement mode and every map.\n^7The system rewards both raw speed and consistency. Every time you\nimprove a record, even by a single millisecond, you earn XP again.")
	ABOUT_PAGE(6, 5, 7, ABOUT_TITLE_6, "^5Strafing ^7is the foundation of all movement modes. While airborne, hold\na strafe key and move your mouse in the same direction simultaneously.\nDone correctly, each jump builds speed beyond the normal movement cap.\n\n^5FPS switching ^7exploits how the engine ties physics calculations to frame\nrate. Different fps values change jump height, distance, and acceleration.\nBind fps values in console: ^2/bind KEY com_maxfps 125^7. Switching at the\nright moment before or during a jump opens up routes otherwise impossible.\n\n^5Bounces ^7are physics exploits triggered by colliding with geometry at very\nspecific angles and speeds, launching you across the map in an instant.\nThey are frame-precise and require consistent setup to execute reliably.\n\n^7Each mode has its own advanced techniques. Search the mode name alongside\n^2CoD4 speedrun^7 on YouTube to find tutorials and record breakdowns.")
	ABOUT_PAGE(7, 6, 8, ABOUT_TITLE_7, "^5IW3SR^7 is a custom CoD4 client built specifically for this server.\nStrongly recommended for all players and essential for the smoothest\nexperience on custom movement modes like Q3, Q3CPM, CS, and Portal.\n\n^5Velocity meter: ^7Real-time velocity display showing your exact speed at\n^7all times, essential for learning and optimizing movement.\n^5CGAZ: ^7Visualizes strafe zones on screen, showing the optimal angle\n^7window to maximize acceleration during every airborne moment.\n^5Bhop script: ^7Optimized bunny hop input handling built directly into\n^7the client for consistent jumps without timing variance.\n^5KMOV: ^7Fully customizable dynamic HUD displays for movement data.\n^5Built-in browser: ^7Watch videos in-game without alt-tabbing.\n\n^7Download and source available at ^2github.com/Iswenzz/IW3SR")
	ABOUT_PAGE(8, 7, 9, ABOUT_TITLE_8, "^7The entire SR project is open source and community maintained.\nEvery part of the server, client, and tooling is publicly available\nfor anyone to explore, learn from, or contribute to.\n\n^7The full codebase is hosted on GitHub. You can browse the source,\nopen issues, suggest features, or submit pull requests directly at\n^2github.com/Iswenzz\n\n^7Contributions of all kinds are welcome and appreciated.\n^7The project grows because of the community. If you have skills\nand want to contribute, the door is open.")
	ABOUT_PAGE(9, 8, 9, ABOUT_TITLE_9, "^7An active community of players, speedrunners, and mappers is\nalways online. Whether you are looking for help, want to share a run,\nor just want to follow the latest updates, come join us.\n\nThe ^5Discord^7 is the heart of the community. It is the best place\nto ask movement questions, get feedback on your runs, report bugs,\nwatch others share their records, and stay up to date with every\nnew map release, mode update, and server announcement.\n\n^7Runners of every skill level are welcome, from first-time players\njust learning to strafe, to veterans pushing for world records.\n\n^5Website: ^2sr-speedrun.com\n^5Discord: ^2discord.gg/76aHfGF\n^5GitHub: ^2github.com/Iswenzz")
}
