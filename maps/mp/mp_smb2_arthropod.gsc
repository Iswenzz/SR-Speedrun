	at[0] = 0;
	points[1] = (0, -1050, -2100);
	angles[1] = (89.9948, 0, 0);
	at[1] = 7.5000;
	points[2] = (0, -1050, -2100);
	angles[2] = (135.0052, 0, 0);
	at[2] = 11.2500;
	points[3] = (0, -1050, -2100);
	angles[3] = (180.0052, 0, 0);
