	thread iz_mover14();
	thread iz_mover15();
	thread iz_mover16();
	thread iz_mover17();
	thread iz_mover18();
	thread iz_mover19();
	thread iz_mover20();
	thread iz_mover21();
	thread iz_mover22();
}

