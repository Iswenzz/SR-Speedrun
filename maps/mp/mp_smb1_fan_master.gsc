	thread iz_mover23();
	thread iz_mover24();
	thread iz_mover25();
	thread iz_mover26();
	thread iz_mover27();
	thread iz_mover28();
	thread iz_mover29();
	thread iz_mover30();
	thread iz_mover31();
	thread iz_mover32();
	thread iz_mover33();
}

