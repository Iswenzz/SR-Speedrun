	angles[455] = (0, -17973.4531, 0);
	at[455] = 99.2500;
	points[456] = (-71.4602, -595, 0);
	angles[456] = (0, -17982.8418, 0);
	at[456] = 99.4000;
	points[457] = (-59.5350, -595, 0);
	angles[457] = (0, -17988.0059, 0);
	at[457] = 99.5000;
	points[458] = (-41.6618, -595, 0);
	angles[458] = (0, -17994.0645, 0);
	at[458] = 99.6500;
	points[459] = (-29.7544, -595, 0);
	angles[459] = (0, -17996.9531, 0);
	at[459] = 99.7500;
	points[460] = (-11.9000, -595, 0);
	angles[460] = (0, -17999.5078, 0);
	at[460] = 99.9000;
	points[461] = (0, -595, 0);
	angles[461] = (0, -18000, 0);
	at[461] = 100;
	mover = getEnt("iz_mover0", "targetname");
	if (!isDefined(mover))
		return;
	rider = getEnt("endmap_trig", "targetname");
	if (isDefined(rider))
	{
		rider enableLinkTo();
		rider linkTo(mover);
	}
	mover thread iz_mover_loop(points, angles, at, false, true);
}

iz_mover_loop(points, angles, at, once, closed)
{
	wait 0.05;
	self iz_place(points[0], iz_pose(angles, 0));
	period = at[at.size - 1];
	if (period < 0.05)
		return;
	done = 0;
	for (pass = 0; !once || pass < 1; pass++)
	{
		if (pass && !closed)
			self iz_place(points[0], iz_pose(angles, 0));
		for (i = 1; i < points.size; i++)
		{
			if (at[i] == at[i - 1])
			{
				self iz_place(points[i], iz_pose(angles, i));
				continue;
			}
			due = int((pass * period + at[i]) * 20 + 0.5);
			if (due <= done)
				continue;
			self iz_move(points[i], iz_pose(angles, i), due - done);
			wait 0.05 * (due - done);
			done = due;
		}
	}
	last = points.size - 1;
	self iz_stop(points[last], iz_pose(angles, last));
}

iz_pose(angles, i)
{
	if (isDefined(angles))
		return angles[i];
}
