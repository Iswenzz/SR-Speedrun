main()
{
	setDvar("bg_falldamagemaxheight", 2000000000);
	setDvar("bg_falldamageminheight", 1500000000);

	visionSetNaked("mp_smb1_factory", 0);

	thread iz_sounds();

	thread iz_bananas();

	thread iz_anims();

	game["allies"] = "marines";
	game["axis"] = "opfor";
	game["attackers"] = "allies";
	game["defenders"] = "axis";
	game["allies_soldiertype"] = "desert";
	game["axis_soldiertype"] = "desert";
}

iz_sounds()
{
	ambientPlay("iz_0_st5", 2);
}

iz_bananas()
{
	bananas = getEntArray("iz_banana", "targetname");
	for (i = 0; i < bananas.size; i++)
		bananas[i] thread iz_banana();
}

iz_banana()
{
	self notSolid();
	// One on a moving group rides what its target names, and a linked
	// entity takes no turn of its own.
	ride = undefined;
	if (isDefined(self.target))
		ride = getEnt(self.target, "targetname");
	if (isDefined(ride))
		self linkTo(ride);
	else
		self thread iz_banana_spin();
	reach = 48;
	if (isDefined(self.radius))
		reach = self.radius;
	for (;;)
	{
		wait 0.1;
		players = getEntArray("player", "classname");
		for (i = 0; i < players.size; i++)
		{
			if (!isAlive(players[i]) || distance(players[i].origin + (0, 0, 35), self.origin) > reach)
				continue;
			if (isDefined(level.iz_cue) && isDefined(level.iz_cue["iz_cue_banana"]))
				players[i] playLocalSound("iz_cue_banana");
			self hide();
			wait 15;
			self show();
			break;
		}
	}
}

iz_banana_spin()
{
	for (;;)
	{
		self rotateYaw(360, 2);
		wait 2;
	}
}

iz_move(origin, angles, frames)
{
	if (!isDefined(self.iz_step))
	{
		self.iz_step = (0, 0, 0);
		self.iz_turn = (0, 0, 0);
	}
	time = frames * 0.05 + 0.0005;
	if (isDefined(origin))
	{
		to = origin - self.iz_step;
		self.iz_step = (to - self.origin) * (1.0 / frames);
		self moveTo(to, time);
	}
	if (isDefined(angles))
	{
		turn = angles - self.iz_turn - self.angles;
		turn = (iz_wrap(turn[0]), iz_wrap(turn[1]), iz_wrap(turn[2]));
		self.iz_turn = turn * (1.0 / frames);
		self rotateTo(self.angles + turn, time);
	}
}

iz_wrap(angle)
{
	return angle - 360 * floor(angle / 360 + 0.5);
}

iz_place(origin, angles)
{
	self.origin = origin;
	if (isDefined(angles))
		self.angles = angles;
	self.iz_step = (0, 0, 0);
	self.iz_turn = (0, 0, 0);
}

iz_stop(origin, angles)
{
	self iz_move(origin, angles, 1);
	wait 0.05;
	self iz_move(origin, angles, 1);
}

iz_anims()
{
	thread iz_mover0();
	thread iz_mover1();
	thread iz_mover2();
	thread iz_mover3();
	thread iz_mover4();
	thread iz_mover5();
	thread iz_mover6();
	thread iz_mover7();
	thread iz_mover8();
	thread iz_mover9();
	thread iz_mover10();
	thread iz_mover11();
	thread iz_mover12();
	thread iz_mover13();
	thread iz_mover14();
	thread iz_mover15();
	thread iz_mover16();
	thread iz_mover17();
	thread iz_mover18();
	thread iz_mover19();
	thread iz_mover20();
	thread iz_mover21();
	thread iz_mover22();
}

iz_mover0()
{
	points = [];
	angles = [];
	at = [];
	points[0] = (323.0768, -1204, 805);
	angles[0] = (0.0015, 0, 0);
	at[0] = 0;
	points[1] = (888.4606, -1204, 805);
	angles[1] = (14.0015, 0, 0);
	at[1] = 3.5000;
	points[2] = (1050, -1204, 805);
	angles[2] = (14.0015, 0, 0);
	at[2] = 4.5000;
	points[3] = (-1050, -1204, 805);
	angles[3] = (14.0015, 0, 0);
	at[3] = 4.5500;
	points[4] = (-1050, -1204, 805);
	angles[4] = (14.0015, 0, 0);
	at[4] = 9.5000;
	points[5] = (0, -1204, 805);
	angles[5] = (14.0015, 0, 0);
	at[5] = 16;
	points[6] = (80.7697, -1204, 805);
	angles[6] = (-5.9985, 0, 0);
	at[6] = 16.5000;
	points[7] = (323.0768, -1204, 805);
	angles[7] = (0.0015, 0, 0);
	at[7] = 18;
	mover = getEnt("iz_mover0", "targetname");
