	at[13] = 2.8000;
	points[14] = (465.5276, 319.6662, 6.7057);
	angles[14] = (0, 6.8113, 0);
	at[14] = 2.9500;
	points[15] = (460.8110, 322.2882, 6.7057);
	angles[15] = (0, 6.3673, 0);
	at[15] = 3.1000;
	points[16] = (448.9252, 328.9004, 6.7057);
	angles[16] = (0, 5.2475, 0);
	at[16] = 3.4000;
	points[17] = (414.4331, 348.0890, 6.7057);
	angles[17] = (0, 1.9976, 0);
	at[17] = 4.1500;
	points[18] = (403.0276, 354.4346, 6.7057);
	angles[18] = (0, 0.9229, 0);
	at[18] = 4.4500;
	points[19] = (398.6536, 356.8658, 6.7057);
	angles[19] = (0, 0.5110, 0);
	at[19] = 4.6000;
	points[20] = (395.4449, 358.6520, 6.7057);
	angles[20] = (0, 0.2086, 0);
	at[20] = 4.7500;
	points[21] = (393.6008, 359.6776, 6.7057);
	angles[21] = (0, 0.0348, 0);
	at[21] = 4.9000;
	points[22] = (393.2315, 359.8827, 6.7057);
	angles[22] = (0, 0, 0);
	at[22] = 5;
	mover = getEnt("iz_mover5", "targetname");
	if (!isDefined(mover))
		return;
	mover thread iz_mover_loop(points, angles, at, false, false);
}

iz_mover_loop(points, angles, at, once, closed)
{
	wait 0.05;
	self iz_place(points[0], iz_pose(angles, 0));
	period = at[at.size - 1];
	if (period < 0.05)
		return;
	done = 0;
	for (pass = 0; !once || pass < 1; pass++)
	{
		if (pass && !closed)
			self iz_place(points[0], iz_pose(angles, 0));
		for (i = 1; i < points.size; i++)
		{
			if (at[i] == at[i - 1])
			{
				self iz_place(points[i], iz_pose(angles, i));
				continue;
			}
			due = int((pass * period + at[i]) * 20 + 0.5);
			if (due <= done)
				continue;
			self iz_move(points[i], iz_pose(angles, i), due - done);
			wait 0.05 * (due - done);
			done = due;
		}
	}
	last = points.size - 1;
	self iz_stop(points[last], iz_pose(angles, last));
}

iz_pose(angles, i)
{
	if (isDefined(angles))
		return angles[i];
}
