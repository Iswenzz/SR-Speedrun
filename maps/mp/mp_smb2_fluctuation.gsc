	points[86] = (-69.5004, -4733.3071, -26.8260);
	angles[86] = (0, 0, 0);
	at[86] = 15.5500;
	points[87] = (-69.5004, -4733.3071, -20.3605);
	angles[87] = (0, 0, 0);
	at[87] = 15.6000;
	points[88] = (-69.5004, -4733.3071, -10.5131);
	angles[88] = (0, 0, 0);
	at[88] = 15.7000;
	points[89] = (-69.5004, -4733.3071, -4.2548);
	angles[89] = (0, 0, 0);
	at[89] = 15.8000;
	points[90] = (-69.5004, -4733.3071, -0.9593);
	angles[90] = (0, 0, 0);
	at[90] = 15.9000;
	points[91] = (-69.5004, -4733.3071, 0);
	angles[91] = (0, 0, 0);
	at[91] = 16;
	points[92] = (-69.5004, -4733.3071, 0);
	angles[92] = (0, 0, 0);
	at[92] = 20;
	mover = getEnt("iz_mover18", "targetname");
	if (!isDefined(mover))
		return;
	mover thread iz_mover_loop(points, angles, at, false, true);
}

iz_mover_loop(points, angles, at, once, closed)
{
	wait 0.05;
	self iz_place(points[0], iz_pose(angles, 0));
	period = at[at.size - 1];
	if (period < 0.05)
		return;
	done = 0;
	for (pass = 0; !once || pass < 1; pass++)
	{
		if (pass && !closed)
			self iz_place(points[0], iz_pose(angles, 0));
		for (i = 1; i < points.size; i++)
		{
			if (at[i] == at[i - 1])
			{
				self iz_place(points[i], iz_pose(angles, i));
				continue;
			}
			due = int((pass * period + at[i]) * 20 + 0.5);
			if (due <= done)
				continue;
			self iz_move(points[i], iz_pose(angles, i), due - done);
			wait 0.05 * (due - done);
			done = due;
		}
	}
	last = points.size - 1;
	self iz_stop(points[last], iz_pose(angles, last));
}

iz_pose(angles, i)
{
	if (isDefined(angles))
		return angles[i];
}
