	angles[152] = (-30.2185, 0, 0);
	at[152] = 7.6000;
	points[153] = (-108.6594, -5775.0396, 291.0126);
	angles[153] = (-26.4411, 0, 0);
	at[153] = 7.6500;
	points[154] = (-90.0425, -5775.0396, 277.6713);
	angles[154] = (-22.6638, 0, 0);
	at[154] = 7.7000;
	points[155] = (-72.3382, -5775.0396, 263.1323);
	angles[155] = (-18.8866, 0, 0);
	at[155] = 7.7500;
	points[156] = (-55.6217, -5775.0396, 247.4681);
