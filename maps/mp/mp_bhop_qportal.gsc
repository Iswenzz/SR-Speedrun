iz_trig_0()
{
	t = getEnt("iz_trig_0", "targetname");
	if (!isDefined(t))
		return;
	t.iz_acts = [];
	t.iz_hold = "activator";
	t.iz_hold_time = 90;
	t thread iz_trig(0.0100);
}

