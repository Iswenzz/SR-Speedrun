	points[1] = (885.8268, 25984.2520, 9153.5430);
	angles[1] = (178.2524, -45, 0);
	at[1] = 0.8500;
	points[2] = (885.8268, 25984.2520, 9153.5430);
	angles[2] = (272.6213, -45, 0);
	at[2] = 1.3000;
	points[3] = (885.8268, 25984.2520, 9153.5430);
	angles[3] = (360, -45, 0);
	at[3] = 1.7167;
	mover = getEnt("iz_obj_1", "targetname");
	if (!isDefined(mover))
		return;
	mover thread iz_mover_loop(points, angles, at, false, true);
}

